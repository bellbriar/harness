{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bellbriar-report/1",
  "description": "The JSON report bellbriar-eval --json writes. docs/REPORT.md describes every field. Within bellbriar-report/1 no field is removed, renamed, or given another type or meaning; a release may add fields, so readers should ignore fields they do not know.",
  "type": "object",
  "required": ["format", "generated_at", "source", "tool",
               "rulebook_version",
               "rulebook_sha256", "rulebook_bundled", "layers",
               "coverage_note", "incomplete", "errors", "site", "rules",
               "fetch", "judged", "baseline", "pages"],
  "properties": {
    "format": {"const": "bellbriar-report/1"},
    "generated_at": {"type": "string",
                     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "source": {"enum": ["files", "render", "urls"]},
    "tool": {"$ref": "#/$defs/tool"},
    "rulebook_version": {"type": ["string", "null"]},
    "rulebook_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rulebook_bundled": {"type": "boolean"},
    "layers": {"type": "array", "items": {"$ref": "#/$defs/layer"}},
    "coverage_note": {"type": "string"},
    "incomplete": {"type": "boolean"},
    "errors": {"type": "integer", "minimum": 0},
    "site": {"$ref": "#/$defs/site"},
    "rules": {"type": "object",
              "additionalProperties": {"$ref": "#/$defs/rule"}},
    "fetch": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/run_fetch"}]},
    "judged": {"type": ["object", "null"]},
    "baseline": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/baseline"}]},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "rate": {"oneOf": [{"type": "null"},
                       {"type": "number", "minimum": 0, "maximum": 1}]},
    "tool": {
      "type": "object",
      "required": ["name", "version", "python", "libraries"],
      "properties": {
        "name": {"const": "bellbriar-harness"},
        "version": {"type": "string"},
        "python": {"type": "string"},
        "libraries": {"type": "object",
                      "additionalProperties": {"type": ["string", "null"]}},
        "from_snapshot": {"type": "object",
                          "additionalProperties": {"type": "string"}}
      }
    },
    "layer": {
      "type": "object",
      "required": ["layer", "status", "note"],
      "properties": {
        "layer": {"type": "string"},
        "status": {"enum": ["executed", "partial", "skipped"]},
        "note": {"type": "string"}
      }
    },
    "site": {
      "type": "object",
      "required": ["site_weighted_pass_rate", "pct_pages_tier1_clean",
                   "pages_not_evaluable", "tier1_rules_executed",
                   "tier1_rules_total", "tier1_rules_review_only",
                   "total_fail_findings", "total_needs_review",
                   "total_third_party_fail_findings",
                   "total_third_party_needs_review", "rule_fail_totals"],
      "properties": {
        "site_weighted_pass_rate": {"$ref": "#/$defs/rate"},
        "pct_pages_tier1_clean": {"$ref": "#/$defs/rate"},
        "pages_not_evaluable": {"$ref": "#/$defs/count"},
        "tier1_rules_executed": {"$ref": "#/$defs/count"},
        "tier1_rules_total": {"$ref": "#/$defs/count"},
        "tier1_rules_review_only": {"$ref": "#/$defs/count"},
        "total_fail_findings": {"$ref": "#/$defs/count"},
        "total_needs_review": {"$ref": "#/$defs/count"},
        "total_third_party_fail_findings": {"$ref": "#/$defs/count"},
        "total_third_party_needs_review": {"$ref": "#/$defs/count"},
        "rule_fail_totals": {"type": "object",
                             "additionalProperties": {"$ref": "#/$defs/count"}}
      }
    },
    "rule": {
      "type": "object",
      "required": ["name", "sc", "tier", "layer", "verdict_basis", "engine",
                   "understanding", "why", "fix", "pages_applicable",
                   "pages_failed", "pages_errored", "fail_findings",
                   "needs_review_findings", "third_party_fail_findings",
                   "third_party_needs_review_findings"],
      "properties": {
        "name": {"type": "string"},
        "sc": {"type": "array", "items": {"type": "string"}},
        "tier": {"type": ["integer", "null"]},
        "layer": {"type": ["string", "null"]},
        "verdict_basis": {"enum": ["sc", "heuristic", "policy",
                                   "best-practice", "review", null]},
        "engine": {"enum": ["bellbriar", "axe-core"]},
        "understanding": {"type": ["string", "null"]},
        "why": {"type": ["string", "null"]},
        "fix": {"type": ["string", "null"]},
        "pages_applicable": {"$ref": "#/$defs/count"},
        "pages_failed": {"$ref": "#/$defs/count"},
        "pages_errored": {"$ref": "#/$defs/count"},
        "fail_findings": {"$ref": "#/$defs/count"},
        "needs_review_findings": {"$ref": "#/$defs/count"},
        "third_party_fail_findings": {"$ref": "#/$defs/count"},
        "third_party_needs_review_findings": {"$ref": "#/$defs/count"}
      }
    },
    "wait": {
      "type": ["object", "null"],
      "required": ["strategy", "quiet_ms", "cap_ms", "waited_ms", "settled",
                   "data_requests", "data_requests_open", "wait_for",
                   "scroll_steps"],
      "properties": {
        "strategy": {"const": "load+scroll+dom-and-data-settle"},
        "quiet_ms": {"type": "integer", "minimum": 0},
        "cap_ms": {"type": "integer", "minimum": 0},
        "waited_ms": {"type": "integer", "minimum": 0},
        "settled": {"type": "boolean"},
        "data_requests": {"type": "integer", "minimum": 0},
        "data_requests_open": {"type": "integer", "minimum": 0},
        "wait_for": {"type": ["string", "null"]},
        "scroll_steps": {"type": "integer", "minimum": 0}
      }
    },
    "baseline": {
      "type": "object",
      "required": ["sha256", "generated_at", "findings", "new_findings",
                   "new_fail_findings"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generated_at": {"type": ["string", "null"]},
        "findings": {"$ref": "#/$defs/count"},
        "new_findings": {"$ref": "#/$defs/count"},
        "new_fail_findings": {"$ref": "#/$defs/count"}
      }
    },
    "run_fetch": {
      "type": "object",
      "required": ["final_url", "host", "pages", "list"],
      "properties": {
        "final_url": {"type": "string"},
        "host": {"type": "string"},
        "pages": {"$ref": "#/$defs/count"},
        "list": {
          "type": "object",
          "required": ["kind", "max_pages"],
          "properties": {
            "kind": {"enum": ["urls", "sitemap"]},
            "max_pages": {"$ref": "#/$defs/count"},
            "url": {"type": "string"},
            "listed": {"$ref": "#/$defs/count"},
            "complete": {"type": "boolean"}
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "required": ["requested_url", "final_url", "host", "mode",
                   "http_status", "redirects", "redacted", "fetched_at",
                   "browser", "viewport", "wait", "instrumented",
                   "provenance_attr", "attribution", "shadow_roots", "axe",
                   "narrow", "reader", "address_class", "address_basis",
                   "snapshot_sha256", "fallback_reason", "notes"],
      "properties": {
        "requested_url": {"type": "string"},
        "final_url": {"type": "string"},
        "host": {"type": "string"},
        "mode": {"enum": ["rendered", "server"]},
        "http_status": {"type": "integer"},
        "redirects": {"type": "array"},
        "redacted": {"type": "array", "items": {"type": "string"}},
        "fetched_at": {"type": "string"},
        "browser": {"type": ["object", "null"]},
        "viewport": {"type": ["object", "null"]},
        "wait": {"$ref": "#/$defs/wait"},
        "instrumented": {"type": "boolean"},
        "provenance_attr": {"type": ["string", "null"]},
        "attribution": {"type": ["object", "null"]},
        "shadow_roots": {"type": ["integer", "null"]},
        "axe": {"type": ["object", "null"]},
        "narrow": {"type": ["object", "null"]},
        "reader": {"enum": ["dom", "html", "xml"]},
        "address_class": {"type": "string"},
        "address_basis": {"enum": ["address", "name"]},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fallback_reason": {"type": ["string", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "page": {
      "type": "object",
      "required": ["path", "fetch", "score", "findings",
                   "not_applicable_rules", "errors"],
      "properties": {
        "path": {"type": "string"},
        "fetch": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/capture"}]},
        "score": {"$ref": "#/$defs/score"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "not_applicable_rules": {"type": "array",
                                 "items": {"type": "string"}},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "error"],
            "properties": {"rule_id": {"type": "string"},
                           "error": {"type": "string"}}
          }
        }
      }
    },
    "score": {
      "type": "object",
      "required": ["path", "weighted_pass_rate", "applicable_weight",
                   "passed_weight", "tier1_clean", "tier1_rules_executed",
                   "tier1_rules_applicable", "evaluable",
                   "not_evaluable_reason", "fail_findings",
                   "needs_review_findings", "third_party_fail_findings",
                   "third_party_needs_review_findings", "failed_rules"],
      "properties": {
        "path": {"type": "string"},
        "weighted_pass_rate": {"$ref": "#/$defs/rate"},
        "applicable_weight": {"$ref": "#/$defs/count"},
        "passed_weight": {"$ref": "#/$defs/count"},
        "tier1_clean": {"type": ["boolean", "null"]},
        "tier1_rules_executed": {"$ref": "#/$defs/count"},
        "tier1_rules_applicable": {"$ref": "#/$defs/count"},
        "evaluable": {"type": "boolean"},
        "not_evaluable_reason": {"type": "string"},
        "fail_findings": {"$ref": "#/$defs/count"},
        "needs_review_findings": {"$ref": "#/$defs/count"},
        "third_party_fail_findings": {"$ref": "#/$defs/count"},
        "third_party_needs_review_findings": {"$ref": "#/$defs/count"},
        "failed_rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding": {
      "type": "object",
      "required": ["rule_id", "verdict", "verdict_basis", "impact",
                   "message", "line", "selector", "snippet", "origin",
                   "origin_detail", "owned", "about", "fingerprint",
                   "in_baseline"],
      "properties": {
        "rule_id": {"type": "string"},
        "verdict": {"enum": ["fail", "needs_review"]},
        "verdict_basis": {"enum": ["sc", "heuristic", "policy",
                                   "best-practice", "review", ""]},
        "impact": {"enum": ["blocker", "serious", "moderate", "minor"]},
        "message": {"type": "string"},
        "line": {"type": ["integer", "null"]},
        "selector": {"oneOf": [{"type": "null"},
                               {"type": "array", "minItems": 1,
                                "items": {"type": "string"}}]},
        "snippet": {"type": "string"},
        "origin": {"type": "string"},
        "origin_detail": {"type": "string"},
        "owned": {"type": "boolean"},
        "about": {"type": "string", "pattern": "^([0-9a-f]{32})?$"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "in_baseline": {"type": ["boolean", "null"]}
      }
    }
  }
}
